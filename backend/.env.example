# Backend Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication (Personal Use)
JWT_SECRET=super_secret_verbalis_jwt_key_2026

# Groq API (STT: Whisper, LLM: LLaMA 70B & 8B)
